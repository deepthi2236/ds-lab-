      "source": [
        "<a href=\"https://colab.research.google.com/github/deepthi2236/ds-lab-/blob/main/binary%20search.traversal\" target=\"_parent\"><img src=\"https://colab.research.google.com/assets/colab-badge.svg\" alt=\"Open In Colab\"/></a>"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "INT_MIN = -2**32\n",
        "\n",
        "def canRepresentBST(pre):\n",
        "    s = []\n",
        "    root = INT_MIN\n",
        "    for value in pre:\n",
        "        if value < root :\n",
        "            return False\n",
        "        while(len(s) > 0 and s[-1] < value):\n",
        "            root = s.pop()\n",
        "        s.append(value)\n",
        "    return True\n",
        "\n",
        "\n",
        "pre1 = [40 , 30 , 35 , 80 , 100]\n",
        "\n",
        "print(\"true\" if canRepresentBST(pre1) == True else \"false\")\n",
        "pre2 = [40 , 30 , 35 , 20 , 80 , 100]\n",
        "print(\"true\" if canRepresentBST(pre2) == True else \"false\")"
      ],
      "metadata": {
        "colab": {
