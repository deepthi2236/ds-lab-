      "source": [
        "class Node:\n",
        "    def __init__(self, data):\n",
        "        self.data = data\n",
        "        self.next = None\n",
        "\n",
        "class CreateList:\n",
        "    def __init__(self):\n",
        "        self.head = None\n",
        "        self.tail = None\n",
        "\n",
        "    def add(self, data):\n",
        "        newNode = Node(data)\n",
        "        if self.head is None:\n",
        "            self.head = newNode\n",
        "            self.tail = newNode\n",
        "            newNode.next = self.head\n",
        "        else:\n",
        "            self.tail.next = newNode\n",
        "            self.tail = newNode\n",
        "            self.tail.next = self.head\n",
        "\n",
        "    def deleteEnd(self):\n",
        "        if self.head is None:\n",
        "            # List is empty, nothing to delete\n",
        "            return\n",
        "        if self.head == self.tail:\n",
        "            # Only one node in the list\n",
        "            self.head = None\n",
        "            self.tail = None\n",
        "            return\n",
        "\n",
        "        current = self.head\n",
        "        while current.next != self.tail:\n",
        "            current = current.next\n",
        "        # current is now the second to last node\n",
        "        self.tail = current\n",
        "        self.tail.next = self.head\n",
        "\n",
        "    def display(self):\n",
        "        if self.head is None:\n",
        "            print(\"List is empty\")\n",
        "            return\n",
        "\n",
        "        print(\"Nodes of the circular linked list:\", end=\" \")\n",
        "        current = self.head\n",
        "        while True:\n",
        "            print(current.data, end=\" \")\n",
        "            current = current.next\n",
        "            if current == self.head:\n",
        "                break\n",
        "        print()\n",
        "\n",
        "# Using CreateList as the circular linked list implementation\n",
        "cl = CreateList()\n",
        "cl.add(1)\n",
        "cl.add(2)\n",
        "cl.add(3)\n",
        "cl.add(4)\n",
        "print(\"Original List:\")\n",
        "cl.display()\n",
        "\n",
        "# Demonstrating deletion until list is empty\n",
        "print(\"\\nDeleting elements:\")\n",
        "while cl.head is not None:\n",
        "    cl.deleteEnd()\n",
        "    print(\"Updated List after deleteEnd:\")\n",
        "    cl.display()"
