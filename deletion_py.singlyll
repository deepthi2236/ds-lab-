            "\n",
            "Removing 'tue':\n",
            "thu\n",
            "wed\n",
            "mon\n",
            "\n",
            "Removing 'thu' (head):\n",
            "wed\n",
            "mon\n",
            "\n",
            "Removing 'nonexistent':\n",
            "wed\n",
            "mon\n"
          ]
        }
      ]
    }
  ]
